# ==============================================================================
# Aarozi Healthcare — Production Environment Configuration Template
# Copy this file to .env on your production server:
# cp deploy/production.env.example .env
# ==============================================================================

# Domain Name (Points to your server public IP, e.g. lab.example.com or aarozi.health)
DOMAIN=lab.example.com

# Database Credentials (PostgreSQL 16)
POSTGRES_DB=aarozi_health
POSTGRES_USER=aarozi_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_64_CHAR_PASSWORD_IN_PRODUCTION

# Redis Cache & Task Queue
REDIS_PASSWORD=CHANGE_THIS_REDIS_SECRET_PASSWORD

# Security & Sessions (Generate using: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_BEFORE_DEPLOYING

# Licensing System (Root Vendor Verification Key)
VENDOR_KEY_ID=aarozi-root-key-2026
VENDOR_PUBLIC_KEY_HEX=5d27445909fb811c78dbe3d0850dc573715771f5983c9ca6bfcb7b41efecb09f

# Application Mode (production | development)
APP_ENV=production
DEBUG=false

