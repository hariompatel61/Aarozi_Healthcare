{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aarozi Healthcare Offline License",
  "type": "object",
  "required": ["license_version","license_id","tenant_id","installation_id","plan_code","mode","valid_from","valid_to","entitlements","limits","signing_key_id","algorithm","signature"],
  "properties": {
    "license_version": {"type": "integer", "minimum": 1},
    "license_id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "installation_id": {"type": "string"},
    "plan_code": {"type": "string"},
    "mode": {"enum": ["OFFLINE_LOCAL", "HYBRID_SYNC", "CLOUD"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": "string", "format": "date-time"},
    "grace_until": {"type": ["string", "null"], "format": "date-time"},
    "entitlements": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "limits": {"type": "object", "additionalProperties": {"type": ["integer","string"]}},
    "signing_key_id": {"type": "string"},
    "algorithm": {"enum": ["Ed25519"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
