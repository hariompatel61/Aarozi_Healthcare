{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Aarozi Healthcare LIS Design Tokens",
  "version": "1.0.0",
  "description": "3-tier token architecture for offline-first clinical laboratory information system",
  "global": {
    "color": {
      "slate": {
        "50": { "value": "#f8fafc" },
        "100": { "value": "#f1f5f9" },
        "200": { "value": "#e2e8f0" },
        "300": { "value": "#cbd5e1" },
        "400": { "value": "#94a3b8" },
        "500": { "value": "#64748b" },
        "600": { "value": "#475569" },
        "700": { "value": "#334155" },
        "800": { "value": "#1e293b" },
        "900": { "value": "#0f172a" },
        "950": { "value": "#020617" }
      },
      "teal": {
        "50": { "value": "#f0fdfa" },
        "100": { "value": "#ccfbf1" },
        "200": { "value": "#99f6e4" },
        "300": { "value": "#5eead4" },
        "400": { "value": "#2dd4bf" },
        "500": { "value": "#14b8a6" },
        "600": { "value": "#0d9488" },
        "700": { "value": "#0f766e" },
        "800": { "value": "#115e59" },
        "900": { "value": "#134e4a" }
      },
      "emerald": {
        "50": { "value": "#ecfdf5" },
        "100": { "value": "#d1fae5" },
        "200": { "value": "#a7f3d0" },
        "300": { "value": "#6ee7b7" },
        "400": { "value": "#34d399" },
        "500": { "value": "#10b981" },
        "600": { "value": "#059669" },
        "700": { "value": "#047857" },
        "800": { "value": "#065f46" },
        "900": { "value": "#064e3b" }
      },
      "red": {
        "50": { "value": "#fef2f2" },
        "100": { "value": "#fee2e2" },
        "200": { "value": "#fecaca" },
        "300": { "value": "#fca5a5" },
        "400": { "value": "#f87171" },
        "500": { "value": "#ef4444" },
        "600": { "value": "#dc2626" },
        "700": { "value": "#b91c1c" },
        "800": { "value": "#991b1b" },
        "900": { "value": "#7f1d1d" }
      },
      "amber": {
        "50": { "value": "#fffbeb" },
        "100": { "value": "#fef3c7" },
        "200": { "value": "#fde68a" },
        "300": { "value": "#fcd34d" },
        "400": { "value": "#fbbf24" },
        "500": { "value": "#f59e0b" },
        "600": { "value": "#d97706" },
        "700": { "value": "#b45309" },
        "800": { "value": "#92400e" },
        "900": { "value": "#78350f" }
      },
      "sky": {
        "50": { "value": "#f0f9ff" },
        "100": { "value": "#e0f2fe" },
        "200": { "value": "#bae6fd" },
        "300": { "value": "#7dd3fc" },
        "400": { "value": "#38bdf8" },
        "500": { "value": "#0ea5e9" },
        "600": { "value": "#0284c7" },
        "700": { "value": "#0369a1" },
        "800": { "value": "#075985" },
        "900": { "value": "#0c4a6e" }
      }
    },
    "spacing": {
      "0": { "value": "0px" },
      "1": { "value": "0.25rem", "comment": "4px" },
      "2": { "value": "0.5rem", "comment": "8px" },
      "3": { "value": "0.75rem", "comment": "12px" },
      "4": { "value": "1rem", "comment": "16px" },
      "5": { "value": "1.25rem", "comment": "20px" },
      "6": { "value": "1.5rem", "comment": "24px" },
      "8": { "value": "2rem", "comment": "32px" },
      "10": { "value": "2.5rem", "comment": "40px" },
      "12": { "value": "3rem", "comment": "48px" },
      "16": { "value": "4rem", "comment": "64px" }
    },
    "typography": {
      "fontFamily": {
        "sans": { "value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
        "mono": { "value": "'Space Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" }
      },
      "fontSize": {
        "xs": { "value": "0.75rem", "comment": "12px (Hard minimum floor for Indian lab monitors)" },
        "sm": { "value": "0.875rem", "comment": "14px" },
        "base": { "value": "1rem", "comment": "16px" },
        "lg": { "value": "1.125rem", "comment": "18px" },
        "xl": { "value": "1.25rem", "comment": "20px" },
        "2xl": { "value": "1.5rem", "comment": "24px" },
        "3xl": { "value": "1.875rem", "comment": "30px" },
        "4xl": { "value": "2.25rem", "comment": "36px" }
      },
      "fontWeight": {
        "normal": { "value": "400" },
        "medium": { "value": "500" },
        "semibold": { "value": "600" },
        "bold": { "value": "700" }
      },
      "lineHeight": {
        "none": { "value": "1" },
        "tight": { "value": "1.25" },
        "snug": { "value": "1.375" },
        "normal": { "value": "1.5" },
        "relaxed": { "value": "1.625" }
      }
    },
    "radius": {
      "none": { "value": "0px" },
      "sm": { "value": "0.25rem", "comment": "4px" },
      "md": { "value": "0.375rem", "comment": "6px" },
      "lg": { "value": "0.5rem", "comment": "8px" },
      "xl": { "value": "0.75rem", "comment": "12px" },
      "2xl": { "value": "1rem", "comment": "16px" },
      "full": { "value": "9999px" }
    },
    "motion": {
      "duration": {
        "fast": { "value": "100ms" },
        "normal": { "value": "150ms" },
        "smooth": { "value": "250ms" }
      },
      "easing": {
        "default": { "value": "cubic-bezier(0.4, 0, 0.2, 1)" },
        "out": { "value": "cubic-bezier(0, 0, 0.2, 1)" }
      }
    }
  },
  "semantic": {
    "surface": {
      "base": { "light": "{global.color.slate.50}", "dark": "{global.color.slate.950}" },
      "card": { "light": "#ffffff", "dark": "{global.color.slate.900}" },
      "subtle": { "light": "{global.color.slate.100}", "dark": "{global.color.slate.800}" },
      "muted": { "light": "{global.color.slate.200}", "dark": "{global.color.slate.800}" },
      "overlay": { "light": "rgba(15, 23, 42, 0.6)", "dark": "rgba(2, 6, 23, 0.8)" }
    },
    "text": {
      "primary": { "light": "{global.color.slate.900}", "dark": "{global.color.slate.50}" },
      "secondary": { "light": "{global.color.slate.600}", "dark": "{global.color.slate.400}" },
      "muted": { "light": "{global.color.slate.400}", "dark": "{global.color.slate.500}" },
      "inverse": { "light": "#ffffff", "dark": "{global.color.slate.900}" }
    },
    "border": {
      "subtle": { "light": "{global.color.slate.200}", "dark": "{global.color.slate.800}" },
      "default": { "light": "{global.color.slate.300}", "dark": "{global.color.slate.700}" },
      "strong": { "light": "{global.color.slate.400}", "dark": "{global.color.slate.600}" }
    },
    "action": {
      "primary": { "light": "{global.color.teal.600}", "dark": "{global.color.teal.500}" },
      "primaryHover": { "light": "{global.color.teal.700}", "dark": "{global.color.teal.600}" },
      "primaryActive": { "light": "{global.color.teal.800}", "dark": "{global.color.teal.700}" },
      "secondary": { "light": "#ffffff", "dark": "{global.color.slate.800}" },
      "secondaryHover": { "light": "{global.color.slate.50}", "dark": "{global.color.slate.700}" }
    },
    "status": {
      "success": {
        "text": { "light": "{global.color.emerald.700}", "dark": "{global.color.emerald.300}" },
        "bg": { "light": "{global.color.emerald.50}", "dark": "rgba(6, 78, 59, 0.3)" },
        "border": { "light": "{global.color.emerald.200}", "dark": "{global.color.emerald.800}" }
      },
      "warning": {
        "text": { "light": "{global.color.amber.700}", "dark": "{global.color.amber.300}" },
        "bg": { "light": "{global.color.amber.50}", "dark": "rgba(120, 53, 15, 0.3)" },
        "border": { "light": "{global.color.amber.200}", "dark": "{global.color.amber.800}" }
      },
      "danger": {
        "text": { "light": "{global.color.red.700}", "dark": "{global.color.red.300}" },
        "bg": { "light": "{global.color.red.50}", "dark": "rgba(127, 29, 29, 0.3)" },
        "border": { "light": "{global.color.red.200}", "dark": "{global.color.red.800}" }
      },
      "info": {
        "text": { "light": "{global.color.sky.700}", "dark": "{global.color.sky.300}" },
        "bg": { "light": "{global.color.sky.50}", "dark": "rgba(12, 74, 110, 0.3)" },
        "border": { "light": "{global.color.sky.200}", "dark": "{global.color.sky.800}" }
      },
      "panic": {
        "text": { "light": "#ffffff", "dark": "#ffffff" },
        "bg": { "light": "{global.color.red.600}", "dark": "{global.color.red.700}" },
        "pulse": { "value": "rgba(239, 68, 68, 0.4)" }
      }
    }
  },
  "component": {
    "button": {
      "heightSm": "1.75rem",
      "heightMd": "2.25rem",
      "heightLg": "2.75rem",
      "radius": "{global.radius.lg}"
    },
    "input": {
      "heightSm": "1.75rem",
      "heightMd": "2.25rem",
      "radius": "{global.radius.lg}"
    },
    "table": {
      "rowDense": "2rem",
      "rowNormal": "2.75rem"
    },
    "badge": {
      "heightSm": "1.25rem",
      "heightMd": "1.5rem"
    }
  }
}

