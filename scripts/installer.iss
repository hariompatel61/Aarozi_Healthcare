; Script generated by Inno Setup Script Wizard.
; Aarozi Healthcare Diagnostic Laboratory & Blood Bank System

#define MyAppName "Aarozi Healthcare"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "Aarozi Health Systems"
#define MyAppURL "https://aarozi.health"
#define MyAppExeName "AaroziHealthcareServer.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
AppId={{5D274459-09FB-811C-78DB-E3D0850DC573}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\AaroziHealthcare
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
LicenseFile=..\LICENSE
OutputDir=..\dist\Installer
OutputBaseFilename=AaroziHealthcare-Setup-v1.0.0
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "autostart"; Description: "Start Aarozi Healthcare automatically when Windows boots"; GroupDescription: "System Integration:"

[Files]
Source: "..\dist\AaroziHealthcare-Lab-Release\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\aarozi_license_*.lic"; DestDir: "{app}\license"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
Name: "{userstartup}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: autostart

[Run]
; Add Windows Firewall Exception for LAN workstations (Port 8000)
Filename: "netsh"; Parameters: "advfirewall firewall add rule name=""Aarozi Healthcare LIS"" dir=in action=allow protocol=TCP localport=8000"; Flags: runhidden
; Launch application after setup
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

